{
  "manifest_version": 3,
  "name": "ORB - Okta Rule Builder",
  "version": "1.0",
  "description": "Okta Rule Builder (ORB) adds extensive group rule functionality",
  "omnibox": {
    "keyword": "orb"
  },
  "action": {
    "default_popup": "menu.html"
  },
  "icons": {
    "16": "ORB_Logo_16.png",
    "32": "ORB_Logo_32.png",
    "64": "ORB_Logo_64.png",
    "128": "ORB_Logo_128.png",
    "256": "ORB_Logo_256.png",
    "500": "ORB_Logo_500.png"
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "permissions": [
    "declarativeContent",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.okta.com/*",
        "https://*.okta-emea.com/*",
        "https://*.oktapreview.com/*",
        "https://*.okta-gov.com/*",
        "https://*.okta.mil/*"
      ],
      "js": [
        "jquery-1.12.4.min.PATCHED.js",
        "okta-rule-builder.js",
        "oel-preview.js",
        "orb-rule-viewer.js",
        "orb-exports.js",
        "verify-mfa.js",
        "workflows.js",
        "orb-plugin.js"
      ],
      "css": [
        "orb.css"
      ]
    }
  ]
}
